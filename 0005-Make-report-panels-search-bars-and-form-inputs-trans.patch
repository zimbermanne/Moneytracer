From 7a2c11b0d129a5c8b81d7545736f7f1ae413f679 Mon Sep 17 00:00:00 2001
From: Reggie <reggie@moneytracer.dev>
Date: Tue, 25 Aug 2026 07:31:14 +0000
Subject: [PATCH 5/5] Make report panels, search bars, and form inputs
 transparent too
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

These were missed by the earlier card/sidebar transparency pass because
they don't use the .card class:

- Reports.jsx: the panel backgrounds for Debtors Report, Creditors
  Report, Inventory Valuation (value-by-category, top items), Trial
  Balance totals, Balance Sheet (assets/liabilities/equity), and
  Profit & Loss (summary/net profit, expenses by category, revenue by
  item, item profitability) were set via inline style={{ background:
  'var(--surface)' }} — solid white — untouched by the earlier
  frost-removal pass since that only rewrote CSS files, not JSX.
- globals.css: the base input/select/textarea rule (every search bar
  and text form field in the app) has used solid var(--surface-sunken)
  since before any of this work started; now transparent. Also cleared
  the dark-mode .search-bar override, which resolved to a solid dark
  navy rather than transparent.
---
 frontend/src/pages/Reports.jsx  | 18 +++++++++---------
 frontend/src/styles/globals.css | 11 +++++------
 2 files changed, 14 insertions(+), 15 deletions(-)

diff --git a/frontend/src/pages/Reports.jsx b/frontend/src/pages/Reports.jsx
index 336439a..f8a09ef 100644
--- a/frontend/src/pages/Reports.jsx
+++ b/frontend/src/pages/Reports.jsx
@@ -98,7 +98,7 @@ function ProfitLoss({ data }) {
       </Accordion>
 
       <Accordion title="2. Expenses by Category" defaultOpen={true}>
-        <div style={{ background: 'var(--surface)', padding: '4px 16px', borderRadius: '12px' }}>
+        <div style={{ background: 'transparent', padding: '4px 16px', borderRadius: '12px' }}>
           {Object.entries(data.expense_by_category).map(([name, val]) => (
             <Row key={name} left={name} right={money(val)} />
           ))}
@@ -109,7 +109,7 @@ function ProfitLoss({ data }) {
       </Accordion>
 
       <Accordion title="3. Revenue by Item" defaultOpen={false}>
-        <div style={{ background: 'var(--surface)', padding: '4px 16px', borderRadius: '12px' }}>
+        <div style={{ background: 'transparent', padding: '4px 16px', borderRadius: '12px' }}>
           {Object.entries(data.revenue_by_item).map(([name, val]) => (
             <Row key={name} left={name} right={money(val)} />
           ))}
@@ -122,7 +122,7 @@ function ProfitLoss({ data }) {
           <div style={{ fontSize: 13, color: 'var(--text-muted)', marginBottom: 15 }}>
             Sorted by gross profit — which items are actually making you money.
           </div>
-          <div style={{ overflowX: 'auto', background: 'var(--surface)', borderRadius: '12px' }}>
+          <div style={{ overflowX: 'auto', background: 'transparent', borderRadius: '12px' }}>
             <table className="pl-table">
               <thead>
                 <tr>
@@ -217,7 +217,7 @@ function LedgerReport({ data, listKey, title }) {
 
       {list.length > 0 && (
         <Accordion title={title} defaultOpen={true}>
-          <div style={{ background: 'var(--surface)', padding: '4px 16px', borderRadius: '12px' }}>
+          <div style={{ background: 'transparent', padding: '4px 16px', borderRadius: '12px' }}>
             {list.map((r, idx) => (
               <Row key={idx} left={`${r.name} (${r.status})`} right={money(r.outstanding)} />
             ))}
@@ -239,7 +239,7 @@ function InventoryValuation({ data }) {
       </div>
 
       <Accordion title="Value by Category" defaultOpen={true}>
-        <div style={{ background: 'var(--surface)', padding: '4px 16px', borderRadius: '12px' }}>
+        <div style={{ background: 'transparent', padding: '4px 16px', borderRadius: '12px' }}>
           {Object.entries(data.by_category).map(([name, val]) => (
             <Row key={name} left={name} right={money(val)} />
           ))}
@@ -247,7 +247,7 @@ function InventoryValuation({ data }) {
       </Accordion>
 
       <Accordion title="Top Items by Value" defaultOpen={true}>
-        <div style={{ background: 'var(--surface)', padding: '4px 16px', borderRadius: '12px' }}>
+        <div style={{ background: 'transparent', padding: '4px 16px', borderRadius: '12px' }}>
           {(data.top_items || []).map((i) => (
             <Row
               key={i.item_name}
@@ -320,7 +320,7 @@ function BalanceSheet({ data }) {
       </div>
 
       <Accordion title="Assets" defaultOpen={true}>
-        <div style={{ background: 'var(--surface)', padding: '4px 16px', borderRadius: '12px' }}>
+        <div style={{ background: 'transparent', padding: '4px 16px', borderRadius: '12px' }}>
           {Object.entries(data.assets || {}).map(([name, val]) => (
             <Row key={name} left={name} right={money(val)} />
           ))}
@@ -329,7 +329,7 @@ function BalanceSheet({ data }) {
       </Accordion>
 
       <Accordion title="Liabilities" defaultOpen={true}>
-        <div style={{ background: 'var(--surface)', padding: '4px 16px', borderRadius: '12px' }}>
+        <div style={{ background: 'transparent', padding: '4px 16px', borderRadius: '12px' }}>
           {Object.entries(data.liabilities || {}).map(([name, val]) => (
             <Row key={name} left={name} right={money(val)} />
           ))}
@@ -338,7 +338,7 @@ function BalanceSheet({ data }) {
       </Accordion>
 
       <Accordion title="Equity" defaultOpen={true}>
-        <div style={{ background: 'var(--surface)', padding: '4px 16px', borderRadius: '12px' }}>
+        <div style={{ background: 'transparent', padding: '4px 16px', borderRadius: '12px' }}>
           {Object.entries(data.equity || {}).map(([name, val]) => (
             <Row key={name} left={name} right={money(val)} />
           ))}
diff --git a/frontend/src/styles/globals.css b/frontend/src/styles/globals.css
index d524cc7..ea3d6e0 100644
--- a/frontend/src/styles/globals.css
+++ b/frontend/src/styles/globals.css
@@ -561,17 +561,16 @@ input, select, textarea {
   border: 1px solid var(--border);
   font-size: 14px;
   width: 100%;
-  background: var(--surface-sunken);
+  background: transparent;
   font-family: inherit;
-  box-shadow: inset 0 1px 0 rgba(255,255,255,0.7), inset 0 -1px 0 rgba(0,0,0,0.04);
   transition: border-color var(--duration) var(--ease), box-shadow var(--duration) var(--ease), background var(--duration) var(--ease);
 }
 
 input:focus, select:focus, textarea:focus {
   outline: none;
   border-color: var(--accent);
-  background: var(--surface-sunken);
-  box-shadow: inset 0 1px 0 rgba(255,255,255,0.8), 0 0 0 3px var(--accent-soft);
+  background: transparent;
+  box-shadow: 0 0 0 3px var(--accent-soft);
 }
 
 /* Selects get a custom chevron (native arrows vary by browser/OS and don't
@@ -3448,7 +3447,7 @@ label {
   }
 :root:not([data-theme]) .dropdown-menu button:hover { background: rgba(255,255,255,0.07); }
 /* ── SearchBar ── */
-:root:not([data-theme]) .search-bar { background: var(--surface); border-color: var(--border-strong); }
+:root:not([data-theme]) .search-bar { background: transparent; border-color: var(--border-strong); }
 /* ── Metric card ── */
 :root:not([data-theme]) .metric-card .label { color: var(--text-muted); }
 :root:not([data-theme]) .metric-card .value { color: var(--text-dark); }
@@ -3605,7 +3604,7 @@ label {
   }
 :root[data-theme="dark"] .dropdown-menu button:hover { background: rgba(255,255,255,0.07); }
 /* ── SearchBar ── */
-:root[data-theme="dark"] .search-bar { background: var(--surface); border-color: var(--border-strong); }
+:root[data-theme="dark"] .search-bar { background: transparent; border-color: var(--border-strong); }
 /* ── Metric card ── */
 :root[data-theme="dark"] .metric-card .label { color: var(--text-muted); }
 :root[data-theme="dark"] .metric-card .value { color: var(--text-dark); }
-- 
