From b36337ae9a72da7545b5567fb652458209a85a4e Mon Sep 17 00:00:00 2001
From: Reggie <reggie@moneytracer.dev>
Date: Tue, 25 Aug 2026 07:16:34 +0000
Subject: [PATCH 4/4] Make cards and sidebar transparent instead of solid white
 (light mode)

- .card, .card:hover, .home-kpi-card, .home-kpi-card:hover: background
  now transparent instead of var(--surface)/var(--surface-sunken); drop
  the box-shadows that were tuned for an opaque surface.
- .sidebar: background now transparent instead of var(--surface).
- dark-theme explicit overrides for .home-kpi-card also switched to
  transparent for consistency (dark-mode .card/.sidebar were already
  low-opacity translucent rgba from before, so left as-is).
- Prep step for re-applying a glass effect on top later; borders are
  kept so card/sidebar edges stay legible on any background.
---
 frontend/src/styles/globals.css | 25 ++++++++++++-------------
 1 file changed, 12 insertions(+), 13 deletions(-)

diff --git a/frontend/src/styles/globals.css b/frontend/src/styles/globals.css
index f63ca6e..d524cc7 100644
--- a/frontend/src/styles/globals.css
+++ b/frontend/src/styles/globals.css
@@ -163,41 +163,41 @@ button {
 }
 
 .card {
-  background: var(--surface) !important;
+  background: transparent !important;
   border: 1px solid var(--border) !important;
   border-radius: 20px;
-  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.08), inset 0 1px 0 0 rgba(255, 255, 255, 0.35) !important;
+  box-shadow: none !important;
   padding: 18px;
   transition: all 0.3s var(--ease);
 }
 
 .card:hover {
-  background: var(--surface-sunken) !important;
+  background: transparent !important;
   transform: translateY(-2px);
-  box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.15), inset 0 1px 0 0 rgba(255, 255, 255, 0.35) !important;
+  box-shadow: none !important;
 }
 
 .home-kpi-card {
-  background: var(--surface) !important;
+  background: transparent !important;
   border-radius: 16px;
   padding: 1.25rem;
   border: 1px solid var(--border) !important;
-  box-shadow: var(--shadow-lg), inset 0 1px 0 0 rgba(255, 255, 255, 0.35) !important;
+  box-shadow: none !important;
   transition: all 0.3s var(--ease);
 }
 
 .home-kpi-card:hover {
-  background: var(--surface-sunken) !important;
+  background: transparent !important;
 }
 
 :root[data-theme="dark"] .home-kpi-card {
-  background: rgba(26, 29, 39, 0.45) !important;
+  background: transparent !important;
   border: 1px solid rgba(255, 255, 255, 0.12) !important;
-  box-shadow: 0 10px 40px 0 rgba(0, 0, 0, 0.4), inset 0 1px 0 0 rgba(255, 255, 255, 0.08) !important;
+  box-shadow: none !important;
 }
 
 :root[data-theme="dark"] .home-kpi-card:hover {
-  background: rgba(26, 29, 39, 0.6) !important;
+  background: transparent !important;
 }
 
 .glass-panel {
@@ -871,11 +871,10 @@ label {
   top: 16px;
   height: calc(100vh - 32px);
   align-self: flex-start;
-  background: var(--surface) !important;
+  background: transparent !important;
   border: 1px solid var(--border-strong) !important;
   border-radius: 20px;
-  box-shadow:
-    inset -1px 0 0 0 var(--border-strong) !important;
+  box-shadow: none !important;
   display: flex;
   flex-direction: column;
   overflow: hidden;
-- 
