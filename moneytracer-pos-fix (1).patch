From 130507e5f482a68977d1623466f3da9d9c803bef Mon Sep 17 00:00:00 2001
From: zimbermanne <zimbermanne@users.noreply.github.com>
Date: Thu, 30 Jul 2026 10:57:08 +0000
Subject: [PATCH] Mobile audit: POS sticky cart bar + fix bottom-nav overlap on
 every page

Audited Dashboard, InvoiceEditor, and POS for leftover desktop-only
layout. Dashboard and InvoiceEditor were already handled well
(card-grid reflows to one column; InvoiceEditor already swaps its
live document preview for a condensed mobile summary). POS had a
real gap and a page-wide bug came up along the way:

- POS: on a phone the cart sits below the entire product grid, so a
  cashier had no way to see the running total or reach checkout
  without scrolling past every product first. Added a sticky mobile
  cart bar (item count + total + 'View Cart') that jumps down to the
  real cart on tap, shown only while cart.length > 0.
- Page-wide bug: .page never accounted for the fixed .bottom-nav bar's
  height, so on every mobile page the last bit of content (e.g. a
  save button) could sit underneath the tab bar. Added bottom padding
  to .page sized to clear it, with safe-area-inset support for
  notched phones.
---
 frontend/src/pages/POS.jsx      | 16 ++++++++++++++--
 frontend/src/styles/globals.css | 32 ++++++++++++++++++++++++++++++--
 2 files changed, 44 insertions(+), 4 deletions(-)

diff --git a/frontend/src/pages/POS.jsx b/frontend/src/pages/POS.jsx
index 9542da3..cc2c6e0 100644
--- a/frontend/src/pages/POS.jsx
+++ b/frontend/src/pages/POS.jsx
@@ -1,4 +1,4 @@
-import { useEffect, useState } from 'react'
+import { useEffect, useRef, useState } from 'react'
 import { useApi } from '../hooks/useApi.js'
 import { apiUrl } from '../api-config.js'
 import { useNavigationGuard } from '../hooks/useNavigationGuard.jsx'
@@ -15,6 +15,7 @@ export default function POS() {
   const [receipt, setReceipt] = useState(null)
   const [busy, setBusy] = useState(false)
   const { setDirty, setDirtyMessage } = useNavigationGuard()
+  const cartRef = useRef(null)
 
   useEffect(() => {
     api.get('/inventory/').then(setItems).catch((e) => setError(e.message))
@@ -149,7 +150,7 @@ export default function POS() {
           </div>
         </div>
 
-        <div style={{ flex: 1, minWidth: 280 }}>
+        <div style={{ flex: 1, minWidth: 280 }} ref={cartRef}>
           <div className="card">
             <h2 style={{ marginTop: 0, fontSize: 16 }}>Cart</h2>
             {cart.length === 0 && <div style={{ color: 'var(--text-muted)', fontSize: 13 }}>No items added.</div>}
@@ -237,6 +238,17 @@ export default function POS() {
           )}
         </div>
       </div>
+
+      {/* Phone-only: the cart lives below a whole grid of products, so
+          without this a cashier has to scroll all the way down just to see
+          the running total or reach checkout. This sticky bar surfaces
+          both at all times and jumps down to the real cart on tap. */}
+      {cart.length > 0 && (
+        <button type="button" className="pos-mobile-cart-bar" onClick={() => cartRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' })}>
+          <span>🛒 {cart.length} item{cart.length !== 1 ? 's' : ''}</span>
+          <span>TZS {total.toLocaleString()} · View Cart ▲</span>
+        </button>
+      )}
     </div>
   )
 }
diff --git a/frontend/src/styles/globals.css b/frontend/src/styles/globals.css
index 28a5beb..73222cc 100644
--- a/frontend/src/styles/globals.css
+++ b/frontend/src/styles/globals.css
@@ -688,9 +688,11 @@ label {
 
   /* Desktop-density spacing is the single biggest reason a responsive page
      still "reads" as a shrunk desktop site instead of a native mobile
-     screen. Phones get tighter, edge-to-edge padding instead. */
+     screen. Phones get tighter, edge-to-edge padding instead. The extra
+     bottom padding clears the fixed .bottom-nav bar, which otherwise
+     covers the last bit of content on every page. */
   .page {
-    padding: 14px;
+    padding: 14px 14px calc(78px + env(safe-area-inset-bottom, 0px));
   }
 
   .page-header h1 {
@@ -785,6 +787,26 @@ label {
   .responsive-table td[data-label=""] {
     display: none;
   }
+
+  .pos-mobile-cart-bar {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 10px;
+    position: fixed;
+    left: 12px;
+    right: 12px;
+    bottom: calc(64px + env(safe-area-inset-bottom, 0px));
+    z-index: 57;
+    background: var(--accent);
+    color: #fff;
+    border: none;
+    border-radius: var(--radius-full);
+    padding: 12px 18px;
+    font-size: 13px;
+    font-weight: 600;
+    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
+  }
 }
 
 @media (min-width: 769px) and (max-width: 1100px) {
@@ -1838,6 +1860,12 @@ label {
   box-shadow: var(--neu-accent-raised);
 }
 
+/* POS: sticky mobile cart summary. Hidden on desktop, where the cart panel
+   already sits next to the product grid with nothing to jump to. */
+.pos-mobile-cart-bar {
+  display: none;
+}
+
 .landing-hero-actions {
   display: flex;
   align-items: center;
-- 
