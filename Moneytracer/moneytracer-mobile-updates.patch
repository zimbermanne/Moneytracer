       </NavigationGuardProvider>
     </AuthProvider>
   )
diff --git a/frontend/src/components/DevicePreview.jsx b/frontend/src/components/DevicePreview.jsx
new file mode 100644
index 0000000..2f0e478
--- /dev/null
+++ b/frontend/src/components/DevicePreview.jsx
@@ -0,0 +1,213 @@
+import { useState } from 'react'
+
+// Dev-only tool: shows the app running inside a phone-shaped frame so you can
+// see mobile styling live while you work, without resizing the browser
+// window. The iframe reloads the current app at the chosen device's viewport
+// size and re-fetches on every route change in the main window (same origin,
+// same cookies/session, so it stays logged in alongside the main tab).
+//
+// Rendered only when running under `vite dev` (import.meta.env.DEV) — it
+// never ships in a production build, see the mount guard in App.jsx.
+
+const DEVICES = {
+  'iphone-se':   { label: 'iPhone SE',      width: 375, height: 667 },
+  'iphone-14':   { label: 'iPhone 14',      width: 390, height: 844 },
+  'iphone-14pm': { label: 'iPhone 14 Pro Max', width: 430, height: 932 },
+  'pixel-7':     { label: 'Pixel 7',        width: 412, height: 915 },
+  'galaxy-s24':  { label: 'Galaxy S24',     width: 384, height: 824 },
+}
+
+export default function DevicePreview() {
+  const [open, setOpen] = useState(false)
+  const [deviceKey, setDeviceKey] = useState('iphone-14')
+  const [landscape, setLandscape] = useState(false)
+  const [reloadTick, setReloadTick] = useState(0)
+
+  const device = DEVICES[deviceKey]
+  const frameWidth = landscape ? device.height : device.width
+  const frameHeight = landscape ? device.width : device.height
+
+  return (
+    <>
+      <button
+        type="button"
+        onClick={() => setOpen(o => !o)}
+        title="Mobile device preview"
+        style={{
+          position: 'fixed',
+          bottom: 20,
+          right: 20,
+          zIndex: 9998,
+          width: 48,
+          height: 48,
+          borderRadius: '50%',
+          border: 'none',
+          background: open ? 'var(--accent-hover)' : 'var(--accent)',
+          color: '#fff',
+          fontSize: 22,
+          boxShadow: '0 4px 14px rgba(0,0,0,0.25)',
+          display: 'flex',
+          alignItems: 'center',
+          justifyContent: 'center',
+        }}
+      >
+        📱
+      </button>
+
+      {open && (
+        <div
+          style={{
+            position: 'fixed',
+            inset: 0,
+            zIndex: 9997,
+            background: 'rgba(43, 38, 34, 0.55)',
+            display: 'flex',
+            alignItems: 'center',
+            justifyContent: 'center',
+            gap: 24,
+            padding: 24,
+          }}
+          onClick={(e) => { if (e.target === e.currentTarget) setOpen(false) }}
+        >
+          {/* Controls panel */}
+          <div
+            style={{
+              background: 'var(--surface)',
+              border: '1px solid var(--border)',
+              borderRadius: 12,
+              padding: 16,
+              display: 'flex',
+              flexDirection: 'column',
+              gap: 12,
+              width: 220,
+              maxHeight: '90vh',
+              overflowY: 'auto',
+            }}
+          >
+            <div style={{ fontWeight: 600, color: 'var(--text-dark)' }}>
+              Mobile Preview
+            </div>
+
+            <label style={{ fontSize: 13, color: 'var(--text-muted)' }}>
+              Device
+              <select
+                value={deviceKey}
+                onChange={(e) => setDeviceKey(e.target.value)}
+                style={{
+                  display: 'block',
+                  width: '100%',
+                  marginTop: 4,
+                  padding: '6px 8px',
+                  borderRadius: 6,
+                  border: '1px solid var(--border-strong)',
+                  background: 'var(--surface)',
+                  color: 'var(--text-dark)',
+                }}
+              >
+                {Object.entries(DEVICES).map(([key, d]) => (
+                  <option key={key} value={key}>
+                    {d.label} ({d.width}×{d.height})
+                  </option>
+                ))}
+              </select>
+            </label>
+
+            <label style={{ display: 'flex', alignItems: 'center', gap: 8, fontSize: 13, color: 'var(--text-muted)' }}>
+              <input
+                type="checkbox"
+                checked={landscape}
+                onChange={(e) => setLandscape(e.target.checked)}
+              />
+              Landscape
+            </label>
+
+            <button
+              type="button"
+              onClick={() => setReloadTick(t => t + 1)}
+              style={{
+                padding: '6px 10px',
+                borderRadius: 6,
+                border: '1px solid var(--border-strong)',
+                background: 'var(--surface-sunken)',
+                color: 'var(--text-dark)',
+                fontSize: 13,
+              }}
+            >
+              ↻ Reload preview
+            </button>
+
+            <button
+              type="button"
+              onClick={() => setOpen(false)}
+              style={{
+                padding: '6px 10px',
+                borderRadius: 6,
+                border: 'none',
+                background: 'var(--accent)',
+                color: '#fff',
+                fontSize: 13,
+              }}
+            >
+              Close
+            </button>
+          </div>
+
+          {/* Phone frame */}
+          <div
+            style={{
+              background: '#1c1c1e',
+              borderRadius: 40,
+              padding: 14,
+              boxShadow: '0 20px 60px rgba(0,0,0,0.5)',
+              flexShrink: 0,
+            }}
+            onClick={(e) => e.stopPropagation()}
+          >
+            <div
+              style={{
+                width: frameWidth,
+                height: frameHeight,
+                borderRadius: 26,
+                overflow: 'hidden',
+                background: '#fff',
+                position: 'relative',
+              }}
+            >
+              {/* Notch, purely cosmetic */}
+              {!landscape && (
+                <div
+                  style={{
+                    position: 'absolute',
+                    top: 0,
+                    left: '50%',
+                    transform: 'translateX(-50%)',
+                    width: '40%',
+                    height: 18,
+                    background: '#1c1c1e',
+                    borderBottomLeftRadius: 12,
+                    borderBottomRightRadius: 12,
+                    zIndex: 1,
+                  }}
+                />
+              )}
+              <iframe
+                key={`${deviceKey}-${landscape}-${reloadTick}`}
+                src={window.location.href}
+                title="Mobile preview"
+                style={{
+                  width: frameWidth,
+                  height: frameHeight,
+                  border: 'none',
+                  display: 'block',
+                }}
+              />
+            </div>
+            <div style={{ textAlign: 'center', color: 'var(--text-faint)', fontSize: 11, marginTop: 8 }}>
+              {device.label} · {frameWidth}×{frameHeight}
+            </div>
+          </div>
+        </div>
+      )}
+    </>
+  )
+}
-- 
