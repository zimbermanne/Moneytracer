From 04bbc91dbf09816d21b7e75f423a217ff6531c99 Mon Sep 17 00:00:00 2001
From: zimbermanne <zimbermanne@users.noreply.github.com>
Date: Wed, 29 Jul 2026 11:52:34 +0000
Subject: [PATCH 1/4] Auto-seed pan-African reference data on startup

Country/RevenueAuthority/Language tables were only ever populated by
manually running seed_pan_african_data.py. Since it was never (or only
partially) run against the live DB, countries present in
african_currencies.py -- like Burkina Faso -- weren't in the DB's
Country table, causing 'Unknown country' errors when saving an account
during registration.

seed_all_pan_african_data() is idempotent (each seed function skips
rows that already exist), so it's now called on every app startup
right after run_migrations(), the same self-healing pattern already
used for schema changes.
---
 webapp/main.py | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/webapp/main.py b/webapp/main.py
index 88107ea..8ebe622 100644
--- a/webapp/main.py
+++ b/webapp/main.py
@@ -10,14 +10,25 @@ from slowapi.middleware import SlowAPIMiddleware
 from database import Base, engine, ensure_schemas
 import models  # noqa: F401 ensures models are registered before create_all
 from migrate import run_migrations
+from seed_pan_african_data import seed_all_pan_african_data
 from rate_limit import limiter
 from routers import auth, inventory, sales, purchases, expenses, ledgers, reports, users, activity, backup, agent, invoices, quotations, customers, accounts, reminders, community, personal, public, reference, purchase_orders, superadmin, bank_loans, deadlines, assets
 from scheduler import start_scheduler
+from database import SessionLocal
 
 ensure_schemas(engine)
 Base.metadata.create_all(bind=engine)
 run_migrations(engine)
 
+# Self-healing reference data: seed_countries()/seed_revenue_authorities()/
+# seed_languages() each skip rows that already exist, so this is safe to run
+# on every startup/deploy. Without this, any country added to
+# african_currencies.py never reaches the live DB until someone remembers to
+# run the seed script by hand -- which is exactly how "Unknown country:
+# Burkina Faso" errors happened during registration.
+with SessionLocal() as _seed_db:
+    seed_all_pan_african_data(_seed_db)
+
 app = FastAPI(title="Moneytracer API", version="2.5.0")
 
 
-- 
2.43.0


From 35b7c625ba4979952e599c82a8bf08ce3fdcbfae Mon Sep 17 00:00:00 2001
From: zimbermanne <zimbermanne@users.noreply.github.com>
Date: Wed, 29 Jul 2026 12:46:32 +0000
Subject: [PATCH 2/4] Add dev-only mobile device-frame preview

New DevicePreview component: a floating toggle button (bottom-right)
that opens the running app inside a phone-shaped frame at real device
viewport dimensions, so mobile styling is visible while developing
without resizing the browser window.

- Presets: iPhone SE, iPhone 14, iPhone 14 Pro Max, Pixel 7, Galaxy S24
- Landscape toggle and manual reload
- Iframe loads window.location.href on same origin, so it shares
  cookies/session with the main tab and reflects the current route
- Gated behind import.meta.env.DEV in App.jsx and verified stripped
  from the production build (zero references in the minified bundle)
---
 frontend/src/App.jsx                      |   5 +
 frontend/src/components/DevicePreview.jsx | 213 ++++++++++++++++++++++
 2 files changed, 218 insertions(+)
 create mode 100644 frontend/src/components/DevicePreview.jsx

diff --git a/frontend/src/App.jsx b/frontend/src/App.jsx
index c9ad962..4d797d7 100644
