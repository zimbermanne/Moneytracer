diff --git a/frontend/src/components/BottomNav.jsx b/frontend/src/components/BottomNav.jsx
new file mode 100644
index 0000000..1cf31eb
--- /dev/null
+++ b/frontend/src/components/BottomNav.jsx
@@ -0,0 +1,48 @@
+import { useLocation } from 'react-router-dom'
+import { useTranslation } from 'react-i18next'
+import { useAuth } from '../hooks/useAuth.jsx'
+import { useNavigationGuard } from '../hooks/useNavigationGuard.jsx'
+
+// Primary destinations only — this sits alongside the hamburger drawer
+// (which still holds the full nav), giving phone users the one-tap-away
+// muscle memory of a real app's tab bar instead of two taps through a
+// slide-out menu for the things they reach for constantly.
+function buildTabs(t) {
+  return [
+    { label: t('nav.home'), icon: '🏠', path: '/app', match: (p) => p === '/app' },
+    { label: t('nav.pos'), icon: '🧾', path: '/app/pos', accountTypes: ['business', 'community'], match: (p) => p === '/app/pos' },
+    { label: t('nav.salesHistory'), icon: '📜', path: '/app/sales', accountTypes: ['business', 'community'], match: (p) => p.startsWith('/app/sales') },
+    { label: t('nav.clientsDebtors'), icon: '📒', path: '/app/debtors', match: (p) => p.startsWith('/app/debtors') },
+  ]
+}
+
+export default function BottomNav({ onMore }) {
+  const location = useLocation()
+  const { guardedNavigate } = useNavigationGuard()
+  const { account } = useAuth()
+  const { t } = useTranslation()
+
+  const tabs = buildTabs(t).filter(
+    (tab) => !tab.accountTypes || tab.accountTypes.includes(account?.account_type)
+  )
+
+  return (
+    <nav className="bottom-nav" aria-label="Primary">
+      {tabs.map((tab) => (
+        <button
+          key={tab.path}
+          type="button"
+          className={`bottom-nav-item ${tab.match(location.pathname) ? 'active' : ''}`}
+          onClick={() => guardedNavigate(tab.path)}
+        >
+          <span className="bottom-nav-icon">{tab.icon}</span>
+          <span className="bottom-nav-label">{tab.label}</span>
+        </button>
+      ))}
+      <button type="button" className="bottom-nav-item" onClick={onMore}>
+        <span className="bottom-nav-icon">☰</span>
+        <span className="bottom-nav-label">{t('nav.more', 'More')}</span>
+      </button>
+    </nav>
+  )
+}
diff --git a/frontend/src/components/Table.jsx b/frontend/src/components/Table.jsx
index 7f64ab4..ecc1962 100644
--- a/frontend/src/components/Table.jsx
+++ b/frontend/src/components/Table.jsx
@@ -8,7 +8,7 @@ export default function Table({ columns, rows, emptyText = 'No records yet.', lo
     return <div className="card" style={{ textAlign: 'center', color: 'var(--text-muted)' }}>{emptyText}</div>
   }
   return (
-    <div className="card" style={{ overflowX: 'auto', padding: 0 }}>
+    <div className="card responsive-table" style={{ overflowX: 'auto', padding: 0 }}>
       <table>
         <thead>
           <tr>
@@ -23,7 +23,16 @@ export default function Table({ columns, rows, emptyText = 'No records yet.', lo
               style={onRowClick ? { cursor: 'pointer' } : undefined}
             >
               {columns.map((col) => (
-                <td key={col.key} onClick={col.stopRowClick ? (e) => e.stopPropagation() : undefined}>
+                <td
+                  key={col.key}
+                  // data-label powers the mobile card layout (see
+                  // .responsive-table in globals.css): below the 640px
+                  // breakpoint each <td> becomes its own row with this as
+                  // a left-hand label, turning a cramped scrolling table
+                  // into a stack of readable label/value pairs per record.
+                  data-label={col.header}
+                  onClick={col.stopRowClick ? (e) => e.stopPropagation() : undefined}
+                >
                   {col.render ? col.render(row) : row[col.key]}
                 </td>
               ))}
diff --git a/frontend/src/styles/globals.css b/frontend/src/styles/globals.css
index 6f0fbc8..28a5beb 100644
--- a/frontend/src/styles/globals.css
+++ b/frontend/src/styles/globals.css
@@ -567,6 +567,14 @@ label {
   padding: 6px 10px 10px;
 }
 
+/* Bottom tab bar — hidden by default (desktop), shown under the 768px
+   breakpoint below. Fixed to the viewport bottom with safe-area padding so
+   it clears the home-indicator on notched iPhones instead of sitting under
+   it. */
+.bottom-nav {
+  display: none;
+}
+
 @media (max-width: 768px) {
   .sidebar {
     position: fixed;
@@ -610,6 +618,173 @@ label {
   }
 
   .app-shell { flex-direction: column; padding: 0; gap: 0; }
+
+  /* Leave room at the bottom of the scrollable content so the fixed tab
+     bar never overlaps the last row of a form or table. */
+  .main-content {
+    padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px));
+  }
+
+  .bottom-nav {
+    display: flex;
+    position: fixed;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    z-index: 58;
+    background: var(--surface);
+    border-top: 1px solid var(--border);
+    padding: 6px 4px calc(6px + env(safe-area-inset-bottom, 0px));
+    box-shadow: 0 -2px 12px rgba(0,0,0,0.08);
+  }
+
+  .bottom-nav-item {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: 2px;
+    min-height: 48px;
+    background: none;
+    border: none;
+    color: var(--text-muted);
+    font-size: 10px;
+    line-height: 1.2;
+    padding: 4px 2px;
+    border-radius: 10px;
+  }
+
+  .bottom-nav-item.active {
+    color: var(--accent);
+  }
+
+  .bottom-nav-icon {
+    font-size: 19px;
+  }
+
+  .bottom-nav-label {
+    max-width: 64px;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+  }
+
+  /* Touch targets: anything tappable should meet the ~44px minimum touch
+     target size on phones, not just shrink to fit desktop density. */
+  .menu-item, .group-header {
+    min-height: 44px;
+    display: flex;
+    align-items: center;
+  }
+
+  button, .btn, input[type="checkbox"], input[type="radio"] {
+    min-height: 40px;
+  }
+
+  input, select, textarea {
+    font-size: 16px; /* prevents iOS Safari auto-zoom on focus */
+  }
+
+  /* Desktop-density spacing is the single biggest reason a responsive page
+     still "reads" as a shrunk desktop site instead of a native mobile
+     screen. Phones get tighter, edge-to-edge padding instead. */
+  .page {
+    padding: 14px;
+  }
+
+  .page-header h1 {
+    font-size: 19px;
+  }
+
+  .card {
+    padding: 14px;
+    border-radius: 14px;
+  }
+
+  .card-grid {
+    gap: 10px;
+  }
+
+  /* Dialogs: on desktop a small centered box makes sense next to a large
+     canvas of content around it. On a phone that same box just looks like
+     a shrunk desktop popup. Native mobile apps use full-width sheets that
+     slide up from the bottom instead — so modals switch to that pattern
+     here rather than just scaling their max-width down. */
+  .modal-overlay {
+    align-items: flex-end;
+  }
+
+  .modal {
+    width: 100%;
+    max-width: 100%;
+    max-height: 85vh;
+    border-radius: 20px 20px 0 0;
+    padding: 20px 16px calc(20px + env(safe-area-inset-bottom, 0px));
+    animation: sheet-up 0.22s var(--ease, ease-out);
+  }
+
+  @keyframes sheet-up {
+    from { transform: translateY(100%); }
+    to { transform: translateY(0); }
+  }
+
+  /* Data tables: a scrolling, shrunk-down grid of tiny cells is the classic
+     "desktop site on a phone" tell. Below this breakpoint every table
+     wearing .responsive-table drops its grid structure and each row
+     becomes its own card — every <td> stacks as a label/value line using
+     the data-label each column already carries (see components/Table.jsx).
+     Row taps and per-cell click-stopping keep working exactly as before
+     since nothing about the DOM structure changes, only how it's drawn. */
+  .responsive-table table,
+  .responsive-table thead,
+  .responsive-table tbody,
+  .responsive-table th,
+  .responsive-table td,
+  .responsive-table tr {
+    display: block;
+  }
+
+  .responsive-table thead {
+    display: none;
+  }
+
+  .responsive-table tr {
+    padding: 12px 14px;
+    border-bottom: 8px solid var(--cream);
+  }
+
+  .responsive-table tr:last-child {
+    border-bottom: none;
+  }
+
+  .responsive-table td {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 12px;
+    padding: 6px 0;
+    border-bottom: none;
+    text-align: right;
+  }
+
+  .responsive-table td::before {
+    content: attr(data-label);
+    color: var(--text-muted);
+    font-size: 12px;
+    font-weight: 600;
+    text-transform: uppercase;
+    letter-spacing: 0.03em;
+    text-align: left;
+    flex-shrink: 0;
+  }
+
+  /* A column with no header text (e.g. a trailing actions/kebab cell)
+     shouldn't render an empty label row — let it sit full-width instead. */
+  .responsive-table td:empty,
+  .responsive-table td[data-label=""] {
+    display: none;
+  }
 }
 
 @media (min-width: 769px) and (max-width: 1100px) {
