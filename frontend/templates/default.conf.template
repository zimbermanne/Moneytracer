# Templated so the listen port comes from Railway's $PORT env var at
# container startup, instead of being hardcoded. The base nginx:alpine
# image auto-runs envsubst on any *.template file here via
# /docker-entrypoint.d/20-envsubst-on-templates.sh, rendering it to
# /etc/nginx/conf.d/default.conf before nginx starts.
#
# Railway assigns a dynamic $PORT and routes traffic to it — it does NOT
# default to 80, so a hardcoded `listen 80;` causes every request to 502
# even though the container itself is healthy.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # index.html must NEVER be cached — it's the entry point that names
    # the current build's hashed JS/CSS filenames. Without this, browsers
    # (mobile especially) apply heuristic caching and can keep serving a
    # stale index.html after a deploy, one that references bundle files
    # from the previous build that no longer exist on disk. The browser
    # then 404s trying to load them and the page never finishes booting
    # -- a blank white screen with no visible error, since it fails before
    # React (and our ErrorBoundary) ever mounts.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # manifest.json is also an entry point of sorts (PWA icon/name config)
    # and small enough that "always revalidate" costs nothing.
    location = /manifest.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Vite fingerprints every JS/CSS asset with a content hash in the
    # filename (e.g. index-DQJxFm2h.css) -- the filename itself changes
    # whenever the content does, so it's always safe to cache these
    # aggressively and permanently.
    location ~* \.(?:js|css|woff2?|ttf|otf|png|jpg|jpeg|svg|webp|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback: any path that isn't a real file goes to index.html
    # so client-side routing (react-router) handles it.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
