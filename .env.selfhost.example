# Copy this to .env (same directory as docker-compose.selfhost.yml) and
# fill in real values. Do NOT commit the filled-in .env file.

# Your domain, pointed at this server's public IP via an A record.
DOMAIN=moneytracer.yourdomain.com

# Generate with: openssl rand -hex 32
SECRET_KEY=

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
