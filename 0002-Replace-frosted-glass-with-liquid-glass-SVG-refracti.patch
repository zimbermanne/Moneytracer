+/* ==========================================================================
+   Liquid Glass upgrade — feature-detected, not browser-sniffed.
+   Filters live in LiquidGlassFilter.jsx, mounted once at the app root
+   (App.jsx). Composing url(#id) with blur()/saturate() in one
+   backdrop-filter list is valid per spec; if the browser doesn't
+   understand url()-filter backdrop-filter at all, the @supports guard
+   means it never sees this block and just keeps the plain-blur fallback
+   set above — no broken/half-applied filter list.
+   ========================================================================== */
+@supports (backdrop-filter: url(#liquid-glass-filter)) {
+  :root {
+    --glass-blur:    url(#liquid-glass-filter) blur(2px);
+    --glass-blur-sm: url(#liquid-glass-filter-sm) blur(1px);
+  }
+}
+
+/* prefers-reduced-motion doesn't disable anything here — the filter is
+   static (no animation loop), just a one-time refraction on the pixels
+   already behind the surface — so there's nothing to reduce. */
+
 /* ==========================================================================
    Dark Mode — override every light token.
    Uses the same variable names so every component that uses var(--surface),
